{
	"name": "Product Sales Analysis",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AdventureWorks2025",
						"type": "LinkedServiceReference"
					},
					"name": "Product"
				},
				{
					"linkedService": {
						"referenceName": "AdventureWorks2025",
						"type": "LinkedServiceReference"
					},
					"name": "ProductSubcategory"
				},
				{
					"linkedService": {
						"referenceName": "AdventureWorks2025",
						"type": "LinkedServiceReference"
					},
					"name": "ProductCategory"
				},
				{
					"linkedService": {
						"referenceName": "AdventureWorks2025",
						"type": "LinkedServiceReference"
					},
					"name": "SalesOrderDetails"
				},
				{
					"linkedService": {
						"referenceName": "AdventureWorks2025",
						"type": "LinkedServiceReference"
					},
					"name": "SalesOrderHeader"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AdventureWorks2025",
						"type": "LinkedServiceReference"
					},
					"name": "Export"
				}
			],
			"transformations": [
				{
					"name": "ProductXXProductSubcategory"
				},
				{
					"name": "ProductXXProducttSubcategoryXXProductCategory"
				},
				{
					"name": "AllProductsSummary"
				},
				{
					"name": "SalesOrderDetailsXXSalesOrderHeader"
				},
				{
					"name": "AllSalesSummary"
				},
				{
					"name": "AllSalesXXAllProducts"
				},
				{
					"name": "GroupingSalesandProducts"
				},
				{
					"name": "ReqSalesXXProducts"
				},
				{
					"name": "AddCaseColumns"
				},
				{
					"name": "FilterNotActiveProdandSalesAfter2023"
				},
				{
					"name": "FilterByHaving"
				},
				{
					"name": "ProductSalesAnalysis"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as integer,",
				"          Name as string,",
				"          ProductNumber as string,",
				"          MakeFlag as boolean,",
				"          FinishedGoodsFlag as boolean,",
				"          Color as string,",
				"          SafetyStockLevel as short,",
				"          ReorderPoint as short,",
				"          StandardCost as decimal(19,4),",
				"          ListPrice as decimal(19,4),",
				"          Size as string,",
				"          SizeUnitMeasureCode as string,",
				"          WeightUnitMeasureCode as string,",
				"          Weight as decimal(8,2),",
				"          DaysToManufacture as integer,",
				"          ProductLine as string,",
				"          Class as string,",
				"          Style as string,",
				"          ProductSubcategoryID as integer,",
				"          ProductModelID as integer,",
				"          SellStartDate as timestamp,",
				"          SellEndDate as timestamp,",
				"          DiscontinuedDate as timestamp,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'Production',",
				"     tableName: 'Product',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> Product",
				"source(output(",
				"          ProductSubcategoryID as integer,",
				"          ProductCategoryID as integer,",
				"          Name as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'Production',",
				"     tableName: 'ProductSubcategory',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> ProductSubcategory",
				"source(output(",
				"          ProductCategoryID as integer,",
				"          Name as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'Production',",
				"     tableName: 'ProductCategory',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> ProductCategory",
				"source(output(",
				"          SalesOrderID as integer,",
				"          SalesOrderDetailID as integer,",
				"          CarrierTrackingNumber as string,",
				"          OrderQty as short,",
				"          ProductID as integer,",
				"          SpecialOfferID as integer,",
				"          UnitPrice as decimal(19,4),",
				"          UnitPriceDiscount as decimal(19,4),",
				"          LineTotal as decimal(38,6),",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'Sales',",
				"     tableName: 'SalesOrderDetail',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> SalesOrderDetails",
				"source(output(",
				"          SalesOrderID as integer,",
				"          RevisionNumber as integer,",
				"          OrderDate as timestamp,",
				"          DueDate as timestamp,",
				"          ShipDate as timestamp,",
				"          Status as integer,",
				"          OnlineOrderFlag as boolean,",
				"          SalesOrderNumber as string,",
				"          PurchaseOrderNumber as string,",
				"          AccountNumber as string,",
				"          CustomerID as integer,",
				"          SalesPersonID as integer,",
				"          TerritoryID as integer,",
				"          BillToAddressID as integer,",
				"          ShipToAddressID as integer,",
				"          ShipMethodID as integer,",
				"          CreditCardID as integer,",
				"          CreditCardApprovalCode as string,",
				"          CurrencyRateID as integer,",
				"          SubTotal as decimal(19,4),",
				"          TaxAmt as decimal(19,4),",
				"          Freight as decimal(19,4),",
				"          TotalDue as decimal(19,4),",
				"          Comment as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'Sales',",
				"     tableName: 'SalesOrderHeader',",
				"     isolationLevel: 'READ_UNCOMMITTED') ~> SalesOrderHeader",
				"Product, ProductSubcategory join(Product@ProductSubcategoryID == ProductSubcategory@ProductSubcategoryID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ProductXXProductSubcategory",
				"ProductXXProductSubcategory, ProductCategory join(ProductSubcategory@ProductCategoryID == ProductCategory@ProductCategoryID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> ProductXXProducttSubcategoryXXProductCategory",
				"ProductXXProducttSubcategoryXXProductCategory select(mapColumn(",
				"          ProductID,",
				"          ProductName = Product@Name,",
				"          Color,",
				"          ListPrice,",
				"          Size,",
				"          SubCategoryName = ProductSubcategory@Name,",
				"          ProductCategoryName = ProductCategory@Name,",
				"          StandardCost",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> AllProductsSummary",
				"SalesOrderDetails, SalesOrderHeader join(SalesOrderDetails@SalesOrderID == SalesOrderHeader@SalesOrderID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> SalesOrderDetailsXXSalesOrderHeader",
				"SalesOrderDetailsXXSalesOrderHeader select(mapColumn(",
				"          OrderQty,",
				"          ProductID,",
				"          UnitPrice,",
				"          SalesOrderID = SalesOrderDetails@SalesOrderID,",
				"          OrderDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> AllSalesSummary",
				"AllSalesSummary, AllProductsSummary join(AllSalesSummary@ProductID == AllProductsSummary@ProductID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> AllSalesXXAllProducts",
				"ReqSalesXXProducts aggregate(groupBy(ProductID,",
				"          ProductName,",
				"          ProductCategoryName,",
				"          SubCategoryName,",
				"          Color,",
				"          Size,",
				"          ListPrice,",
				"          StandardCost),",
				"     TotalQuantitySold = sum(OrderQty),",
				"          TotalSalesAmount = sum(OrderQty*UnitPrice),",
				"          AverageSellingPrice = toDecimal(avg(UnitPrice),8,4),",
				"          NumberOfOrders = countAllDistinct(SalesOrderID),",
				"          HighestSellingPrice = max(UnitPrice),",
				"          LowestSellingPrice = min(UnitPrice),",
				"          EstimatedProfit = sum(OrderQty*(UnitPrice-StandardCost))) ~> GroupingSalesandProducts",
				"FilterNotActiveProdandSalesAfter2023 select(mapColumn(",
				"          OrderQty,",
				"          UnitPrice,",
				"          ProductID = AllProductsSummary@ProductID,",
				"          ProductName,",
				"          Color,",
				"          ListPrice,",
				"          Size,",
				"          SubCategoryName,",
				"          ProductCategoryName,",
				"          StandardCost,",
				"          SalesOrderID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ReqSalesXXProducts",
				"GroupingSalesandProducts derive(PriceCategory = case(ListPrice >= 1000,'Premium',ListPrice >= 500,'High',ListPrice>= 200,'Medium',ListPrice>= 0,'Low','No Price'),",
				"          SalesPerformance = case(TotalSalesAmount >= 100000,'Top Performer',TotalSalesAmount >= 50000,'Good Performer',TotalSalesAmount>= 1000,'Average Performer','Low Performer'),",
				"          ProfitMargin = case(\r",
				"    TotalSalesAmount == 0,\r",
				"    toDecimal(0, 14, 2),\r",
				"    toDecimal(\r",
				"        divide(\r",
				"            toDecimal(EstimatedProfit, 14, 4),\r",
				"            toDecimal(TotalSalesAmount, 14, 4)\r",
				"        ) * 100,\r",
				"        14,\r",
				"        2\r",
				"    )\r",
				")) ~> AddCaseColumns",
				"AllSalesXXAllProducts filter(ListPrice>0 && toDate(OrderDate) >= toDate('2013-01-01')) ~> FilterNotActiveProdandSalesAfter2023",
				"AddCaseColumns filter(TotalSalesAmount >= 1000) ~> FilterByHaving",
				"FilterByHaving select(mapColumn(",
				"          ProductID,",
				"          ProductName,",
				"          ProductCategory = ProductCategoryName,",
				"          SubCategory = SubCategoryName,",
				"          Color,",
				"          Size,",
				"          ListPrice,",
				"          TotalQuantitySold,",
				"          TotalSalesAmount,",
				"          AverageSellingPrice,",
				"          NumberOfOrders,",
				"          HighestSellingPrice,",
				"          LowestSellingPrice,",
				"          PriceCategory,",
				"          SalesPerformance,",
				"          EstimatedProfit,",
				"          ProfitMargin",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> ProductSalesAnalysis",
				"ProductSalesAnalysis sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'table',",
				"     store: 'sqlserver',",
				"     schemaName: 'dbo',",
				"     tableName: 'ProductSalesAnalysis',",
				"     insertable: true,",
				"     updateable: false,",
				"     deletable: false,",
				"     upsertable: false,",
				"     recreate: true,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     saveOrder: 1,",
				"     errorHandlingOption: 'stopOnFirstError') ~> Export"
			]
		}
	}
}